<!-- Pre-Android-12 mirror of data_extraction_rules.xml. -->
<full-backup-content>
    <exclude
        domain="database"
        path="dosette.db" />
    <exclude
        domain="database"
        path="dosette.db-wal" />
    <exclude
        domain="database"
        path="dosette.db-shm" />
